{
  "name": "moreton-island-living-map",
  "productName": "Moreton Island Living Map",
  "version": "1.1.0",
  "description": "Windows wrapper for the Moreton Island living map",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-map": "node prepare.js",
    "dist": "node prepare.js && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.deepspace.moretonislandlivingmap",
    "productName": "Moreton Island Living Map",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "map",
        "to": "map"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Moreton-Island-Living-Map-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Moreton-Island-Living-Map-${version}.${ext}"
    },
    "afterPack": "./afterPack.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "rcedit": "4.0.1"
  },
  "author": "Deepspace000"
}
